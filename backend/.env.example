# --- Gemini / text AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase (hosted Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Forms / Drive integration ---
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=./credentials/google-oauth-token.json
GOOGLE_FORM_TEMPLATE_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- Local interview recordings (relative to the repository root) ---
RECORDINGS_DIR=./backend/recordings

# --- Auth / JWT ---
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173

# --- First HR admin seed (used by `python -m scripts.seed_admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
